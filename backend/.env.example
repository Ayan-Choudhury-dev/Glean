# Password for the bundled Postgres. Change this before first boot.
POSTGRES_PASSWORD=change-me

# Host port the API is exposed on. The app connects to http://<host>:PORT
PORT=8000

# Shared token the app sends on every request. Without it the API is open to
# anyone who can reach the port. Generate one:
#   openssl rand -hex 24
# Then enter the same value in the app: Settings -> Add member -> Advanced.
GLEAN_TOKEN=
