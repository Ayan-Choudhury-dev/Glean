    {
      "type": "text",
      "id": "xzAog",
      "x": 2900,
      "y": 4614,
      "name": "Note / Name household",
      "metadata": {
        "type": "note"
      },
      "fill": "#717171",
      "textGrowth": "fixed-width",
      "width": 340,
      "content": "FLOW CONTEXT · Access (name household)\nSTATE: local-only path — no server, no account.\nINPUT: household name + your display name. Both are local rows, not credentials.\nACTION: Create household → write the DB, seed default categories/locations → Pantry.\nRESTORE: 'Restore from a backup file' opens the document picker first, so an existing install can skip setup.\nEMPTY GUARD: name is the only required field; trimming avoids '  ' passing the check.",
      "fontFamily": "Inter",
      "fontSize": 10,
      "fontWeight": "normal"
    },
    {
      "type": "text",
      "id": "Deb8b",
      "x": 3370,
      "y": 4614,
      "name": "Note / Local ready",
      "metadata": {
        "type": "note"
      },
      "fill": "#717171",
      "textGrowth": "fixed-width",
      "width": 340,
      "content": "FLOW CONTEXT · Access (local ready)\nSTATE: household created in SQLite, no server configured.\nPURPOSE: state the trade-off plainly — this data does not follow you to another device.\nACTIONS: Start with your pantry → /(tabs) · Turn on sync later → Settings ▸ Server.\nCOPY: 'local' and 'on this device' do the work; avoid the word 'sync' in this state.\nEDGE: if the app is reinstalled before a backup, the household is gone — the export CTA must be one tap away.",
      "fontFamily": "Inter",
      "fontSize": 10,
      "fontWeight": "normal"
    },
