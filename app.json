{
  "expo": {
    "name": "Glean",
    "slug": "Glean",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "glean",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.github.ayanchoudhury.glean"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F7F1E8"
      },
      "predictiveBackGestureEnabled": false,
      "package": "io.github.ayanchoudhury.glean",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Glean uses your photos so you can add images to inventory items."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Glean uses the camera to scan product barcodes when adding items."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7F1E8"
        }
      ],
      "expo-status-bar",
      "expo-sharing",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "afbc30dc-3cd1-4476-a608-8a0234493629"
      }
    },
    "owner": "ayan_dev"
  }
}
