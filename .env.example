# Optional. Glean works with no server. These are only needed if you want the
# app to talk to a self-hosted backend during development.
#
# The app also lets you enter the server URL + anon key in
# Profile → Self-hosted backend, so none of these are required to run it.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Shelved Google OAuth. Leave empty.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
